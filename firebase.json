{
  "hosting": {
    "site": "dotclashai",
    "public": "deeplink-hosting",
    "ignore": [
      "firebase.json",
      "**/README.md"
    ],
    "rewrites": [
      { "source": "/join", "destination": "/join.html" },
      { "source": "/privacy", "destination": "/privacy.html" }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [{ "key": "Content-Type", "value": "application/json" }]
      }
    ]
  }
}
